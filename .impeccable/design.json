  "narrative": {
    "northStar": "The Self-Printed Book（一本自印的摄影书）",
    "overview": "整个站点是一册摊开的自印摄影书：访客翻跨页而不是扫缩略图网格。纸面是冷调未涂布纸的灰白，文字是印刷墨的黑，全站只有朱砂一色——印章、批注记号与册编号的颜色。界面家具全部来自书的物质世界；照片以满版或跨页图版出现，永远配拍摄单说明签。",
    "keyCharacteristics": [
      "纸白 + 墨黑 + 唯一朱砂强调色；照片承担全部色彩",
      "竖排中文是结构件：书脊导航、栏目名、大标题",
      "系列编号即册页码（No.01…），帧号即页码片",
      "微标签走打字机等宽体",
      "零圆角（印章除外），零渐变文字，禁用玻璃拟态"
    ],
    "rules": [
      { "name": "The One Seal Rule", "body": "朱砂只用于盖章级语义（编号、印章、记号、当前项），面积 ≤5%。", "section": "colors" },
      { "name": "The Photos Own Color Rule", "body": "UI 永不与照片抢色；照片里的红是照片的红，UI 的朱砂只在纸面上。", "section": "colors" },
      { "name": "The Three Voices Rule", "body": "竖排大宋体=书，黑体=文，等宽=数据；越界即破功。", "section": "typography" },
      { "name": "The Positive Tracking Rule", "body": "中文只用正值宽字距（.05em–.5em），永不负字距压中文。", "section": "typography" },
      { "name": "The Paper-Stack Rule", "body": "深度=图版压在纸上，不是飘在云上；0 偏移彩色光晕违规。", "section": "elevation" }
    ],
    "dos": [
      "Do 让照片承担全部色彩，UI 只用纸墨朱三系",
      "Do 新页面沿用章节题行三段式：册号（等宽朱砂）+ 题名（宋体 900）+ 元数据（等宽墨浅）",
      "Do 图版必配页码片或拍摄单；文字行长 ≤66ch、行高 1.9",
      "Do 保持安静页→重图版的翻页节奏，章间留白 --gap-page",
      "Do 动效一次编排（rise 错峰 + 灯箱形变），尊重 prefers-reduced-motion"
    ],
    "donts": [
      "Don't 给 UI 加照片里没有的第三种彩色；朱砂不做大面积底色",
      "Don't 用圆角（印章除外）、渐变文字、玻璃拟态、硬偏移阴影",
      "Don't 把首页做成等权缩略图网格",
      "Don't 给标题加 kicker/eyebrow 小帽",
      "Don't 让等宽体承担散文、宋体承担参数表",
      "Don't 未经 ※示例 标注就展示虚构 EXIF 或站点数据"
    ]
  }
