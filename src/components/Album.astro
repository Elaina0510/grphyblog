---
/* ============================================================================
 * Album.astro —— 摄影集画册翻页（系列详情页的照片呈现方式）
 *
 * 一屏摊开两张照片（对页），左右翻页，像翻实体摄影集。取代旧的「平铺网格 + 点开灯箱」。
 *
 * 数据：由页面把所有帧按 album.paginateAlbum 切成对页传进来；本组件不产数据、
 *       不内联任何照片路径。宽高一律 sidecar 真值（页面已解析好 URL）。
 *
 * 交互：
 *   - 左右按钮 / 键盘 ←→（Home/End）/ 触摸左右滑 翻页；
 *   - 到头就停（aria-disabled，但按钮仍可聚焦，焦点不吃掉）；
 *   - 换页 aria-live 播报「第 N 页，共 M 页」；
 *   - 页码片走 PageChip（帧号语义沿用）。
 *
 * 无 JS 降级：所有对页都渲染进 DOM，CSS 默认只显示第一屏（.album[data-ready] 之前）；
 *   JS 启动后给根加 data-ready，才按 data-index 显示当前页。禁用 JS 时读者仍能看到第一对页，
 *   内容不缺失（不藏全部、不造空壳）。
 *
 * 硬约束：样式值只走 global.css 的 var()（组件层零色值 / 零字面尺寸）。
 * ==========================================================================*/
import PageChip from './PageChip.astro';
import { announceSpread, spreadLabel } from '../utils/album';
import type { AlbumSpread } from '../utils/album';

interface Props {
  spreads: AlbumSpread[];
  /** 照片总帧数（可能小于 spreads.length * 2，末屏只有 1 张时） */
  frameTotal?: number;
  /** 画册的可读名（无障碍） */
  label?: string;
}

const { spreads, frameTotal, label = '摄影集画册' } = Astro.props;
const total = spreads.length;
const frameCount = frameTotal ?? spreads.reduce((n, s) => n + s.photos.length, 0);
---

<section
  class="album rise"
  data-album
  data-ready="false"
  data-index="0"
  data-total={total}
  aria-label={label}
  tabindex="0"
>
  {
    total > 0 ? (
      <div class="album-bar">
        <button type="button" class="album-nav" data-album-prev aria-label="上一页（左方向键）">
          <span aria-hidden="true">←</span>
        </button>
        <span class="album-chip" data-album-chip>
          {spreadLabel(0, total)}
        </span>
        <output class="album-live" data-album-live role="status" aria-live="polite">
          {announceSpread(0, total)}
        </output>
        <button type="button" class="album-nav" data-album-next aria-label="下一页（右方向键）">
          <span aria-hidden="true">→</span>
        </button>
      </div>
    ) : null
  }

  <div class="album-stage" data-album-stage>
    {
      spreads.map((spread, pageIndex) => (
        <div
          class="album-spread"
          data-album-spread
          data-index={pageIndex}
          data-active={pageIndex === 0 ? 'true' : 'false'}
          data-state={pageIndex === 0 ? 'active' : 'hidden'}
          data-page="spread"
          aria-hidden={pageIndex === 0 ? undefined : 'true'}
        >
          {spread.photos.map((item, within) => (
            <figure
              class="album-plate"
              data-page="plate"
              data-frame={pageIndex * 2 + within}
              aria-hidden={pageIndex === 0 && within === 0 ? undefined : 'true'}
            >
              <div class="album-plate__media">
                <img
                  src={item.src}
                  width={item.width}
                  height={item.height}
                  alt={item.alt}
                  loading={pageIndex === 0 && within === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                  fetchpriority={pageIndex === 0 && within === 0 ? 'high' : undefined}
                />
                <PageChip current={pageIndex * 2 + within + 1} total={frameCount} />
              </div>
            </figure>
          ))}
        </div>
      ))
    }
  </div>

  {
    total > 0 ? (
      <p class="album-hint mono" aria-hidden="true">
        左右方向键 / 滑动翻页 · {spreadLabel(0, total)}
      </p>
    ) : null
  }
</section>

<style>
  .album {
    position: relative;
  }

  .album:focus {
    outline: none;
  }

  .album:focus-visible {
    outline: var(--rule-w) solid var(--ink);
    outline-offset: var(--hairline-gap);
  }

  .album-bar {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--gap-inline);
    margin-bottom: var(--gap-baseline);
  }

  .album-chip {
    font-family: var(--font-mono);
    font-size: var(--text-label-md);
    letter-spacing: var(--tracking-wide);
    color: var(--paper);
    background: var(--night);
    padding: var(--gap-stack-xs) var(--gap-stack-sm);
  }

  .album-live {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    color: var(--ink-soft);
  }

  .album-nav {
    font-family: var(--font-mono);
    font-size: var(--text-label-lg);
    color: var(--ink);
    background: none;
    border: var(--rule-w) solid var(--rule);
    border-radius: 0;
    min-width: var(--lb-hit);
    min-height: var(--lb-hit);
    padding: var(--gap-stack-xs);
    cursor: pointer;
    transition:
      color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease);
  }

  .album-nav:hover,
  .album-nav:focus-visible {
    color: var(--cinnabar);
    border-color: var(--cinnabar);
  }

  .album-nav[aria-disabled='true'] {
    opacity: var(--lb-dim);
    cursor: default;
  }

  /* 舞台：所有页叠在同一个网格单元里，翻页时旧页绕书脊 3D 翻走，露出下面的新页。 */
  .album-stage {
    display: grid;
    perspective: var(--album-spread-perspective);
  }

  /* 宽屏：对页 .album-spread 是翻页单位（两图并排） */
  .album-spread {
    grid-area: 1 / 1;
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--gap-spread);
    align-items: center;
    transform-origin: left center; /* 书脊在左，像真书一样翻 */
    backface-visibility: hidden;
  }

  /* 页的可见状态：只作用于带 data-state 的当前页单位；中性页无此属性自然显示 */
  [data-page][data-state='hidden'] {
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
  }

  [data-page][data-state='active'] {
    visibility: visible;
    opacity: 1;
    z-index: 2;
  }

  /* 翻页：旧页翻走。ease-in-out 慢起慢停，配合 1.3s 时长，像手指轻推书页自然落下 */
  .album[data-ready='true'] [data-page][data-state='out-next'] {
    visibility: visible;
    z-index: 3;
    animation: album-turn-next var(--dur-page-turn) ease-in-out both;
  }

  .album[data-ready='true'] [data-page][data-state='out-prev'] {
    visibility: visible;
    z-index: 3;
    animation: album-turn-prev var(--dur-page-turn) ease-in-out both;
  }

  .album[data-ready='true'] [data-page][data-state='in'] {
    visibility: visible;
    z-index: 1;
    opacity: 1;
  }

  .album-plate {
    margin: 0;
  }

  /* 翻页时盖在转动页上的阴影：随翻页动画由浅入深，像纸背压出的暗面 */
  [data-page]::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--scrim-night);
    opacity: 0;
    pointer-events: none;
  }

  .album[data-ready='true'] [data-page][data-state='out-next']::after {
    animation: album-shade var(--dur-page-turn) ease-in both;
  }

  @keyframes album-shade {
    from {
      opacity: 0;
    }
    to {
      opacity: 0.42;
    }
  }

  .album-plate__media {
    position: relative;
    overflow: hidden;
    box-shadow: var(--shadow-plate);
    background: var(--paper-deep);
  }

  .album-plate__media > img {
    display: block;
    width: 100%;
    height: auto;
  }

  .album-hint {
    text-align: center;
    font-size: var(--text-label);
    color: var(--ink-soft);
    margin-top: var(--gap-baseline);
  }

  /* 往后翻：旧页绕书脊向左翻走（正 rotateY 把右半页翻向读者再翻过去） */
  @keyframes album-turn-next {
    from {
      transform: rotateY(0);
      opacity: 1;
    }
    60% {
      opacity: 1;
    }
    to {
      transform: rotateY(-88deg);
      opacity: 0;
    }
  }

  /* 往前翻：上一页从左侧翻回来盖住当前页 */
  @keyframes album-turn-prev {
    from {
      transform: rotateY(86deg);
      opacity: 0;
    }
    to {
      transform: rotateY(0);
      opacity: 1;
    }
  }

  @media (max-width: 900px) {
    /* 竖屏：spread 不再是对页容器，让每张 .album-plate 直接成为翻页单位 */
    .album-spread {
      display: contents;
    }
    .album-plate[data-page] {
      grid-area: 1 / 1;
      position: relative;
      transform-origin: left center;
      backface-visibility: hidden;
      width: 100%;
    }
    /* 无 JS 降级：首帧只有第一张可见，其余收起（避免两张叠在一起） */
    .album[data-ready='false'] .album-plate[data-frame]:not([data-frame='0']) {
      visibility: hidden;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .album[data-ready='true'] [data-page][data-state='out-next'],
    .album[data-ready='true'] [data-page][data-state='out-prev'],
    .album[data-ready='true'] [data-page][data-state='in'] {
      animation: none;
    }
  }
</style>

<script>
  import { announceSpread, clampSpread, spreadLabel } from '../utils/album';

  const root = document.querySelector<HTMLElement>('[data-album]');
  if (root) {
    const spreads = Array.from(root.querySelectorAll<HTMLElement>('[data-album-spread]'));
    const plates = Array.from(root.querySelectorAll<HTMLElement>('[data-page="plate"]'));
    const prev = root.querySelector<HTMLButtonElement>('[data-album-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-album-next]');
    const chip = root.querySelector<HTMLElement>('[data-album-chip]');
    const live = root.querySelector<HTMLElement>('[data-album-live]');
    const stage = root.querySelector<HTMLElement>('[data-album-stage]');
    const hint = root.querySelector<HTMLElement>('.album-hint');
    const frameTotal = plates.length;

    if (frameTotal > 0 && prev && next && chip && live && stage) {
      // 宽屏一页两张对页；窄屏（≤900px）一页一张。两种模式的页单位不同。
      const narrowMq = typeof matchMedia === 'function' ? matchMedia('(max-width: 900px)') : null;
      const isNarrow = (): boolean => narrowMq?.matches ?? window.innerWidth <= 900;
      let pages: HTMLElement[] = isNarrow() ? plates : spreads;
      let index = 0;
      let animating = false;
      let turnToken = 0;
      const reduce =
        typeof matchMedia === 'function' &&
        matchMedia('(prefers-reduced-motion: reduce)').matches;
      const turnMs = (() => {
        const raw = getComputedStyle(document.documentElement)
          .getPropertyValue('--dur-page-turn')
          .trim();
        const n = Number.parseFloat(raw);
        return Number.isFinite(n) ? (/ms$/.test(raw) ? n : n * 1000) : 700;
      })();

      /** 把一页设成某状态，并同步 aria-hidden（spread 模式要连带它内部的 plate）。 */
      function stateOf(s: HTMLElement, state: string): void {
        s.dataset.state = state;
        s.dataset.active = String(state === 'active' || state === 'in');
        const visible = state === 'active' || state === 'in';
        if (visible) s.removeAttribute('aria-hidden');
        else s.setAttribute('aria-hidden', 'true');
        // spread 模式下，内部 plate 的 aria-hidden 跟着 spread；plate 模式下各自独立。
        if (s.dataset.page === 'spread') {
          s.querySelectorAll<HTMLElement>('[data-page="plate"]').forEach((p) => {
            if (visible) p.removeAttribute('aria-hidden');
            else p.setAttribute('aria-hidden', 'true');
          });
        }
      }

      function syncChrome(): void {
        const count = pages.length;
        chip!.textContent = spreadLabel(index, count);
        live!.textContent = announceSpread(index, count);
        if (hint) {
          const base = hint.textContent ?? '';
          hint.textContent = base.replace(/\d+\s*\/\s*\d+\s*$/, spreadLabel(index, count));
        }
        prev!.setAttribute('aria-disabled', String(index <= 0));
        next!.setAttribute('aria-disabled', String(index >= count - 1));
        root!.dataset.index = String(index);
        root!.dataset.total = String(count);
        root!.dataset.mode = isNarrow() ? 'single' : 'spread';
        root!.dataset.ready = 'true';
      }

      /** 首帧 / 跳页：直接落位，无动画。 */
      function paint(): void {
        pages.forEach((s, i) => stateOf(s, i === index ? 'active' : 'hidden'));
        // 非当前模式的页单位回到中性（无 data-state），由 CSS 自然显示/隐藏
        const others = isNarrow() ? spreads : plates;
        others.forEach((s) => {
          delete s.dataset.state;
          delete s.dataset.active;
          s.setAttribute('aria-hidden', 'true');
        });
        syncChrome();
      }

      /** 切换宽窄模式：尽力保留阅读进度（按当前首帧映射到新模式的页）。 */
      function relayout(): void {
        const wasNarrow = pages === plates;
        const nowNarrow = isNarrow();
        if (wasNarrow === nowNarrow) return;
        settle();
        // 当前正在看的第一帧号 → 新模式里的页序号
        const firstFrame = wasNarrow
          ? Number(pages[index]?.dataset.frame ?? index)
          : index * 2;
        pages = nowNarrow ? plates : spreads;
        index = clampSpread(nowNarrow ? firstFrame : Math.floor(firstFrame / 2), pages.length);
        paint();
      }

      /** 立即结束当前动画并落定（供连续翻页 / 换模式抢占）。 */
      function settle(): void {
        turnToken += 1;
        if (!animating) return;
        pages.forEach((s, i) => stateOf(s, i === index ? 'active' : 'hidden'));
        animating = false;
      }

      function go(delta: number): void {
        settle();
        const target = clampSpread(index + delta, pages.length);
        if (target === index) return;
        const from = pages[index];
        const to = pages[target];
        if (!from || !to) return;

        if (reduce) {
          stateOf(from, 'hidden');
          stateOf(to, 'active');
          index = target;
          syncChrome();
          return;
        }

        animating = true;
        const myToken = turnToken;
        stateOf(to, 'in');
        stateOf(from, delta > 0 ? 'out-next' : 'out-prev');
        index = target;
        syncChrome();

        window.setTimeout(() => {
          if (myToken !== turnToken) return;
          stateOf(from, 'hidden');
          stateOf(to, 'active');
          animating = false;
        }, turnMs + 30);
      }

      prev.addEventListener('click', () => go(-1));
      next.addEventListener('click', () => go(1));
      if (typeof narrowMq?.addEventListener === 'function') narrowMq.addEventListener('change', relayout);
      else window.addEventListener('resize', relayout);

      document.addEventListener('keydown', (event) => {
        const active = document.activeElement;
        if (active !== root && !root.contains(active)) return;
        switch (event.key) {
          case 'ArrowRight':
            event.preventDefault();
            go(1);
            break;
          case 'ArrowLeft':
            event.preventDefault();
            go(-1);
            break;
          case 'Home':
            event.preventDefault();
            settle();
            index = 0;
            paint();
            break;
          case 'End':
            event.preventDefault();
            settle();
            index = pages.length - 1;
            paint();
            break;
          default:
            break;
        }
      });

      // 触摸左右滑翻页（指针事件，鼠标不接管，避免与点击冲突）
      let gesture: { x: number; y: number; id: number } | null = null;
      stage.addEventListener('pointerdown', (event) => {
        if (event.pointerType === 'mouse') return;
        gesture = { x: event.clientX, y: event.clientY, id: event.pointerId };
      });
      stage.addEventListener('pointerup', (event) => {
        if (!gesture || gesture.id !== event.pointerId) return;
        const dx = event.clientX - gesture.x;
        const dy = event.clientY - gesture.y;
        gesture = null;
        if (Math.abs(dx) < Math.abs(dy)) return;
        const threshold = Math.max(40, window.innerWidth * 0.08);
        if (dx <= -threshold) go(1);
        else if (dx >= threshold) go(-1);
      });
      stage.addEventListener('pointercancel', () => {
        gesture = null;
      });

      paint();
    }
  }
</script>
