---
/* ============================================================================
 * Album.astro —— 摄影集画册翻页（系列详情页的照片呈现方式）
 *
 * 一屏摊开两张照片（对页），中缝压一道书脊，左右翻页，像翻实体摄影集。
 * 取代旧的「平铺网格 + 点开灯箱」。
 *
 * 版式（2026-11-22 调整）：
 *   ① 舞台两侧各一枚翻页键（宽屏贴边垂直居中；窄屏浮到舞台顶部两角，不占照片宽度）；
 *   ② 宽屏对页两图紧贴，中缝由 .album-spread[data-count='2']::after 画书脊
 *      （纸面 → 弯折暗部 → 装订线）；窄屏 spread 退成 contents，书脊随之消失；
 *   ③ 舞台下方一条帧窗格：全部帧的缩略图，点一下跳到该帧所在对页，当前页高亮。
 *
 * 数据：由页面把所有帧按 album.paginateAlbum 切成对页传进来；本组件不产数据、
 *       不内联任何照片路径。宽高一律 sidecar 真值（页面已解析好 URL）。
 *
 * 交互：
 *   - 左右按钮 / 键盘 ←→（Home/End）/ 触摸左右滑 翻页；
 *   - 帧窗格点击直达（不播翻页动画，长距离跳页要立即到位）；
 *   - 到头就停（aria-disabled，但按钮仍可聚焦，焦点不吃掉）；
 *   - 换页 aria-live 播报「第 N 页，共 M 页」；帧窗格 aria-current 标当前帧；
 *   - 页码片走 PageChip（帧号语义沿用）。
 *
 * 无 JS 降级：所有对页都渲染进 DOM，CSS 默认只显示第一屏（.album[data-ready] 之前）；
 *   JS 启动后给根加 data-ready，才按 data-index 显示当前页。禁用 JS 时读者仍能看到第一对页，
 *   内容不缺失（不藏全部、不造空壳）。
 *
 * 硬约束：样式值只走 global.css 的 var()（组件层零色值 / 零字面尺寸）。
 * ==========================================================================*/
import PageChip from './PageChip.astro';
import { announceSpread, spreadLabel } from '../utils/album';
import type { AlbumSpread } from '../utils/album';

interface Props {
  spreads: AlbumSpread[];
  /** 照片总帧数（可能小于 spreads.length * 2，末屏只有 1 张时） */
  frameTotal?: number;
  /** 画册的可读名（无障碍） */
  label?: string;
}

const { spreads, frameTotal, label = '摄影集画册' } = Astro.props;
const total = spreads.length;
/** 全部帧（帧窗格按帧铺），顺序与对页一致 */
const frames = spreads.flatMap((spread) => spread.photos);
const frameCount = frameTotal ?? frames.length;
---

<section
  class="album rise"
  data-album
  data-ready="false"
  data-index="0"
  data-total={total}
  aria-label={label}
  tabindex="0"
>
  {
    total > 0 ? (
      <div class="album-frame">
        <div class="album-stage" data-album-stage>
    {
      spreads.map((spread, pageIndex) => (
        <div
          class="album-spread"
          data-album-spread
          data-index={pageIndex}
          data-count={spread.photos.length}
          data-active={pageIndex === 0 ? 'true' : 'false'}
          data-state={pageIndex === 0 ? 'active' : 'hidden'}
          data-page="spread"
          aria-hidden={pageIndex === 0 ? undefined : 'true'}
        >
          {spread.photos.map((item, within) => (
            <figure
              class="album-plate"
              data-page="plate"
              data-frame={pageIndex * 2 + within}
              aria-hidden={pageIndex === 0 && within === 0 ? undefined : 'true'}
            >
              <div class="album-plate__media">
                <img
                  src={item.src}
                  width={item.width}
                  height={item.height}
                  alt={item.alt}
                  loading="eager"
                  decoding="async"
                  fetchpriority={pageIndex === 0 && within === 0 ? 'high' : undefined}
                />
                <PageChip current={pageIndex * 2 + within + 1} total={frameCount} />
              </div>
            </figure>
          ))}
        </div>
      ))
    }

    <!-- 翻页盖层：一张双面书叶。正面=当前页，背面=目标页；绕书脊翻过来才露出新页，
         翻页过程中新页始终被纸背盖住，不会从底下提前显示。运行时由 JS 填充两面内容。 -->
    <div class="album-leaf" data-album-leaf data-turning="false" data-dir="next" aria-hidden="true">
      <div class="album-leaf__face album-leaf__front" data-leaf-front></div>
      <div class="album-leaf__face album-leaf__back" data-leaf-back></div>
    </div>
        </div>

        <div class="album-navbar">
          <button
            type="button"
            class="album-nav album-nav--prev"
            data-album-prev
            aria-label="上一页（左方向键）"
          >
            <span aria-hidden="true">←</span>
          </button>
          <button
            type="button"
            class="album-nav album-nav--next"
            data-album-next
            aria-label="下一页（右方向键）"
          >
            <span aria-hidden="true">→</span>
          </button>
        </div>
      </div>

      <div class="album-foot">
        <div class="album-foot__meta">
          <span class="album-chip" data-album-chip>
            {spreadLabel(0, total)}
          </span>
          <output class="album-live" data-album-live role="status" aria-live="polite">
            {announceSpread(0, total)}
          </output>
        </div>

        <div class="album-strip" data-album-strip role="group" aria-label={`${label} · 照片窗格`}>
          {frames.map((frame, i) => (
            <button
              type="button"
              class="album-strip__item"
              data-album-strip-item
              data-frame={i}
              data-current={i === 0 ? 'true' : 'false'}
              aria-label={`第 ${i + 1} 帧`}
              aria-current={i === 0 ? 'true' : undefined}
            >
              <img src={frame.src} width={frame.width} height={frame.height} alt="" />
            </button>
          ))}
        </div>
      </div>
    ) : null
  }
</section>

<style>
  .album {
    position: relative;
  }

  .album:focus {
    outline: none;
  }

  .album:focus-visible {
    outline: var(--rule-w) solid var(--ink);
    outline-offset: var(--hairline-gap);
  }

  /* 舞台 + 两侧翻页键：按钮占 1/3 列，舞台在中间列。
     窄屏时 .album-navbar 从 contents 变成一行，按钮落到照片下方，不压照片。 */
  .album-frame {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--gap-inline);
  }

  .album-navbar {
    display: contents;
  }

  .album-chip {
    font-family: var(--font-mono);
    font-size: var(--text-label-md);
    letter-spacing: var(--tracking-wide);
    color: var(--paper);
    background: var(--night);
    padding: var(--gap-stack-xs) var(--gap-stack-sm);
  }

  .album-live {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    color: var(--ink-soft);
  }

  .album-nav {
    font-family: var(--font-mono);
    font-size: var(--text-label-lg);
    color: var(--ink);
    background: var(--scrim-paper);
    border: var(--rule-w) solid var(--rule);
    border-radius: 0;
    min-width: var(--lb-hit);
    min-height: var(--lb-hit);
    padding: var(--gap-stack-xs);
    cursor: pointer;
    transition:
      color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease);
  }

  .album-nav:hover,
  .album-nav:focus-visible {
    color: var(--cinnabar);
    border-color: var(--cinnabar);
  }

  .album-nav[aria-disabled='true'] {
    opacity: var(--lb-dim);
    cursor: default;
  }

  .album-nav--prev {
    grid-area: 1 / 1;
  }

  .album-nav--next {
    grid-area: 1 / 3;
  }

  /* 舞台：所有页叠在同一个网格单元里。翻页时由双面书叶接管，真实页先隐藏。
     投影只加在舞台整体上 —— 两页各自投影会在中缝叠加成一条脏影。 */
  .album-stage {
    grid-area: 1 / 2;
    display: grid;
    box-shadow: var(--shadow-plate);
    perspective: var(--album-spread-perspective);
  }

  /* 宽屏：对页 .album-spread 是翻页单位（两页等高，中缝压书脊） */
  .album-spread {
    grid-area: 1 / 1;
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: var(--album-page-h);
    gap: 0;
    align-items: stretch;
  }

  /* 书脊：两页之间一条实色窄脊（纸白 6 + 两侧发丝线），干净、不压照片。
     翻页时书叶两面也画一份，中缝不会在中途消失。 */
  :is(.album-spread, .album-leaf__face)[data-count='2']::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    z-index: 2;
    width: var(--album-spine-bar);
    transform: translateX(-50%);
    background: var(--album-spine-fill);
    pointer-events: none;
  }

  /* 页的可见状态 */
  [data-page][data-state='hidden'] {
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
  }

  [data-page][data-state='active'] {
    visibility: visible;
    opacity: 1;
    z-index: 1;
  }

  /* ---- 双面书叶：翻页时盖住舞台，正面当前页 / 背面目标页 ---- */
  .album-leaf {
    grid-area: 1 / 1;
    position: relative;
    z-index: 5;
    display: none;
    width: 100%;
    transform-style: preserve-3d;
    transform-origin: left center; /* 书脊在左 */
  }

  .album-leaf[data-turning='true'] {
    display: grid;
  }

  .album-leaf__face {
    grid-area: 1 / 1; /* 两面叠在同一格，leaf 高度由内容撑起 */
    /* 内容由 JS 从对应页克隆进来 */
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: var(--album-page-h);
    gap: 0;
    align-items: stretch;
    background: var(--paper);
    box-shadow: var(--shadow-plate);
  }

  /* 正面（旧页）：翻过 90° 后藏起来，避免它背对时透出来干扰背面 */
  .album-leaf__front {
    backface-visibility: hidden;
  }

  .album-leaf__back {
    transform: rotateY(180deg); /* 背面预先翻好，等叶子整体翻过来时正对读者 */
    backface-visibility: hidden;
  }

  /* 背面（新页）随翻页渐渐显出，翻到后半段已清晰，避免落定瞬间才蹦出来 */
  .album-leaf[data-dir='next'][data-turning='true'] .album-leaf__back {
    animation: leaf-back-in var(--dur-page-turn) ease-in both;
  }

  @keyframes leaf-back-in {
    0%,
    35% {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  /* 往后翻：叶子从 0° 转到 -180°，背面（新页）随之翻到正面 */
  .album-leaf[data-dir='next'][data-turning='true'] {
    animation: leaf-next var(--dur-page-turn) ease-in-out both;
  }

  /* 往前翻：上一页从 -180° 翻回 0° */
  .album-leaf[data-dir='prev'][data-turning='true'] {
    animation: leaf-prev var(--dur-page-turn) ease-in-out both;
  }

  @keyframes leaf-next {
    from {
      transform: rotateY(0deg);
    }
    to {
      transform: rotateY(-180deg);
    }
  }

  @keyframes leaf-prev {
    from {
      transform: rotateY(-180deg);
    }
    to {
      transform: rotateY(0deg);
    }
  }

  .album-plate {
    margin: 0;
    display: grid;
    min-height: 0;
    padding: var(--album-page-pad);
    background: var(--paper);
  }

  /* 照片贴在自己的页纸上：不另加投影、不留内衬，中缝暗部只压照片本身。
     这里用 flex 而不是 grid —— grid item 的 height: 100% 相对的行高由内容撑开，
     会形成循环依赖而失效，竖图就会顶出页框被裁。 */
  .album-plate__media {
    position: relative;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    overflow: hidden;
    background: none;
    box-shadow: none;
  }

  /* 照片贴在页纸上，撑满版心但按原比例完整显示（contain 不裁切）。
     不用 max-height: 100% —— grid item 的百分比 max-height 在这种隐式行里会失效，
     竖图会顶出页框被 overflow 裁掉。 */
  .album-plate__media > img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* ---- 舞台下方：页码 + 帧窗格 ---- */
  .album-foot {
    display: grid;
    gap: var(--gap-stack-sm);
    margin-top: var(--gap-baseline);
  }

  .album-foot__meta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--gap-inline);
  }

  .album-strip {
    position: relative;
    display: flex;
    gap: var(--album-strip-gap);
    overflow-x: auto;
    padding-bottom: var(--gap-stack-xs);
    scrollbar-width: thin;
  }

  /* 帧窗格：等高不等宽，按原图比例裁成竖条 —— 竖图不会被方形框裁掉上下 */
  .album-strip__item {
    flex: 0 0 auto;
    height: var(--album-strip-h);
    width: auto;
    padding: 0;
    overflow: hidden;
    border: var(--rule-w) solid var(--rule);
    background: var(--paper-deep);
    opacity: var(--album-strip-dim);
    cursor: pointer;
    transition:
      opacity var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease);
  }

  .album-strip__item:hover,
  .album-strip__item:focus-visible {
    opacity: 1;
  }

  .album-strip__item[data-current='true'] {
    opacity: 1;
    border-color: var(--cinnabar);
  }

  .album-strip__item > img {
    display: block;
    height: 100%;
    width: auto;
  }

  @media (max-width: 900px) {
    /* 竖屏：spread 不再是对页容器，让每张 .album-plate 直接成为翻页单位 */
    .album-spread {
      display: contents;
    }
    /* 所有页（含真实页与书叶）垂直居中，横图不再顶部对齐、翻页时也不跳位 */
    .album-stage,
    .album-leaf__face {
      align-items: center;
    }
    .album-plate[data-page] {
      grid-area: 1 / 1;
      position: relative;
      width: 100%;
      transition: opacity var(--dur-fast) var(--ease);
    }
    /* 书叶两面在竖屏也只有一张图，取消宽屏的等高版心 */
    .album-leaf__face {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
    }
    /* 窄屏不套页框：照片自己撑满宽度 */
    .album-plate__media {
      height: auto;
      padding: 0;
    }
    .album-plate__media > img {
      width: 100%;
      height: auto;
      object-fit: fill;
    }
    /* 窄屏一页一张，不要对页书脊 */
    :is(.album-spread, .album-leaf__face)::after {
      display: none;
    }
    /* 窄屏：舞台吃满一行，翻页键落到照片下方一行，不压照片 */
    .album-frame {
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
    }
    .album-stage {
      grid-area: 1 / 1;
      box-shadow: none;
    }
    .album-navbar {
      display: flex;
      grid-area: 2 / 1;
      align-items: center;
      justify-content: center;
      gap: var(--gap-inline);
      margin-top: var(--gap-stack-sm);
    }
    /* 窄屏不套页框：照片自己撑满，不带纸边与页投影 */
    .album-plate {
      padding: 0;
      background: none;
      box-shadow: none;
    }
    /* 无 JS 降级：首帧只有第一张可见，其余收起（避免两张叠在一起） */
    .album[data-ready='false'] .album-plate[data-frame]:not([data-frame='0']) {
      visibility: hidden;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .album-leaf[data-turning='true'] {
      animation: none;
    }
  }
</style>

<script>
  import { announceSpread, clampSpread, spreadLabel } from '../utils/album';

  const root = document.querySelector<HTMLElement>('[data-album]');
  if (root) {
    const spreads = Array.from(root.querySelectorAll<HTMLElement>('[data-album-spread]'));
    const plates = Array.from(root.querySelectorAll<HTMLElement>('[data-page="plate"]'));
    const prev = root.querySelector<HTMLButtonElement>('[data-album-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-album-next]');
    const chip = root.querySelector<HTMLElement>('[data-album-chip]');
    const live = root.querySelector<HTMLElement>('[data-album-live]');
    const stage = root.querySelector<HTMLElement>('[data-album-stage]');
    const strip = root.querySelector<HTMLElement>('[data-album-strip]');
    const stripItems = strip
      ? Array.from(strip.querySelectorAll<HTMLElement>('[data-album-strip-item]'))
      : [];
    const frameTotal = plates.length;

    if (frameTotal > 0 && prev && next && chip && live && stage) {
      // 宽屏一页两张对页；窄屏（≤900px）一页一张。两种模式的页单位不同。
      const narrowMq = typeof matchMedia === 'function' ? matchMedia('(max-width: 900px)') : null;
      const isNarrow = (): boolean => narrowMq?.matches ?? window.innerWidth <= 900;
      let pages: HTMLElement[] = isNarrow() ? plates : spreads;
      let index = 0;
      let animating = false;
      let turnToken = 0;
      let stripCentered = false;
      const reduce =
        typeof matchMedia === 'function' &&
        matchMedia('(prefers-reduced-motion: reduce)').matches;
      const turnMs = (() => {
        const raw = getComputedStyle(document.documentElement)
          .getPropertyValue('--dur-page-turn')
          .trim();
        const n = Number.parseFloat(raw);
        return Number.isFinite(n) ? (/ms$/.test(raw) ? n : n * 1000) : 700;
      })();

      const leaf = root.querySelector<HTMLElement>('[data-album-leaf]');
      const leafFront = root.querySelector<HTMLElement>('[data-leaf-front]');
      const leafBack = root.querySelector<HTMLElement>('[data-leaf-back]');

      /** 把某页里的图版克隆进书叶的一面。 */
      function fillFace(face: HTMLElement | null, page: HTMLElement): void {
        if (!face) return;
        face.replaceChildren();
        // 页单位是 spread（含若干 figure）或单个 figure 本身
        const figures = page.matches('figure')
          ? [page]
          : Array.from(page.querySelectorAll<HTMLElement>('figure.album-plate'));
        for (const fig of figures) {
          const clone = fig.cloneNode(true) as HTMLElement;
          clone.removeAttribute('data-state');
          clone.style.visibility = 'visible';
          clone.style.opacity = '1';
          face.append(clone);
        }
        face.dataset.count = String(figures.length);
      }

      /** 把一页设成某状态，并同步 aria-hidden（spread 模式要连带它内部的 plate）。 */
      function stateOf(s: HTMLElement, state: string): void {
        s.dataset.state = state;
        s.dataset.active = String(state === 'active' || state === 'in');
        const visible = state === 'active' || state === 'in';
        if (visible) s.removeAttribute('aria-hidden');
        else s.setAttribute('aria-hidden', 'true');
        // spread 模式下，内部 plate 的 aria-hidden 跟着 spread；plate 模式下各自独立。
        if (s.dataset.page === 'spread') {
          s.querySelectorAll<HTMLElement>('[data-page="plate"]').forEach((p) => {
            if (visible) p.removeAttribute('aria-hidden');
            else p.setAttribute('aria-hidden', 'true');
          });
        }
      }

      /**
       * 帧窗格跟随当前页：宽屏当前对页含两帧，窄屏含一帧。
       * 高亮 + aria-current，并把该帧滚到窗格中央（只滚窗格自身，不带动整页）。
       */
      function syncStrip(): void {
        if (!strip || stripItems.length === 0) return;
        const narrow = isNarrow();
        stripItems.forEach((el, i) => {
          const on = narrow ? i === index : Math.floor(i / 2) === index;
          el.dataset.current = String(on);
          if (on) el.setAttribute('aria-current', 'true');
          else el.removeAttribute('aria-current');
        });
        const anchor = stripItems[narrow ? index : index * 2];
        if (!anchor) return;
        const left = anchor.offsetLeft - (strip.clientWidth - anchor.offsetWidth) / 2;
        strip.scrollTo({
          left: Math.max(0, left),
          behavior: stripCentered && !reduce ? 'smooth' : 'auto',
        });
        stripCentered = true;
      }

      function syncChrome(): void {
        const count = pages.length;
        chip!.textContent = spreadLabel(index, count);
        live!.textContent = announceSpread(index, count);
        syncStrip();
        prev!.setAttribute('aria-disabled', String(index <= 0));
        next!.setAttribute('aria-disabled', String(index >= count - 1));
        root!.dataset.index = String(index);
        root!.dataset.total = String(count);
        root!.dataset.mode = isNarrow() ? 'single' : 'spread';
        root!.dataset.ready = 'true';
      }

      /** 首帧 / 跳页：直接落位，无动画。 */
      function paint(): void {
        pages.forEach((s, i) => stateOf(s, i === index ? 'active' : 'hidden'));
        // 非当前模式的页单位回到中性（无 data-state），由 CSS 自然显示/隐藏
        const others = isNarrow() ? spreads : plates;
        others.forEach((s) => {
          delete s.dataset.state;
          delete s.dataset.active;
          s.setAttribute('aria-hidden', 'true');
        });
        syncChrome();
      }

      /** 切换宽窄模式：尽力保留阅读进度（按当前首帧映射到新模式的页）。 */
      function relayout(): void {
        const wasNarrow = pages === plates;
        const nowNarrow = isNarrow();
        if (wasNarrow === nowNarrow) return;
        settle();
        // 当前正在看的第一帧号 → 新模式里的页序号
        const firstFrame = wasNarrow
          ? Number(pages[index]?.dataset.frame ?? index)
          : index * 2;
        pages = nowNarrow ? plates : spreads;
        index = clampSpread(nowNarrow ? firstFrame : Math.floor(firstFrame / 2), pages.length);
        paint();
      }

      /** 立即结束当前动画并落定到目标页（供连续翻页 / 换模式抢占）。 */
      function settle(): void {
        turnToken += 1;
        if (leaf) leaf.dataset.turning = 'false';
        if (!animating) return;
        pages.forEach((s, i) => stateOf(s, i === index ? 'active' : 'hidden'));
        animating = false;
      }

      /**
       * 真书页翻页：把当前页和目标页分别复制到书叶正反面，隐藏真实页，
       * 书叶绕书脊翻 180°（背面在翻过来之前由 backface-visibility 盖住），
       * 动画结束才显示目标真实页并撤掉书叶。全程目标页不会提前露出。
       */
      function go(delta: number): void {
        settle();
        const target = clampSpread(index + delta, pages.length);
        if (target === index) return;
        const from = pages[index];
        const to = pages[target];
        if (!from || !to || !leaf) return;

        // 窄屏一页一张，3D 书页翻转会把照片压成窄条（透视压缩），
        // 读者看到的是「照片没显示全」。窄屏直接落位，不做翻页动画。
        if (reduce || isNarrow()) {
          stateOf(from, 'hidden');
          stateOf(to, 'active');
          index = target;
          syncChrome();
          return;
        }

        // 书叶正面 = 当前页；背面 = 目标页。往后翻时背面要预翻 180° 才对。
        fillFace(leafFront, from);
        fillFace(leafBack, to);
        leaf.dataset.dir = delta > 0 ? 'next' : 'prev';

        animating = true;
        const myToken = turnToken;
        // 真实页全部隐藏，交给书叶接管（此刻读者看到的仍是当前页，只是换成了书叶正面）
        pages.forEach((s) => stateOf(s, 'hidden'));
        leaf.dataset.turning = 'true';
        index = target;
        syncChrome();

        /**
         * 落定：撤掉书叶、显示目标真实页。用 animationend 精确对齐动画结束，
         * 不用 setTimeout 猜时间（猜早了会漏出翻页中的背面，猜晚了翻完会空一帧）。
         * 另留一个略宽的兜底 timer，防止 animationend 因异常没触发时卡死。
         */
        function land(event?: AnimationEvent): void {
          // 只认书叶自身的翻页动画，忽略子元素冒泡上来的 animationend
          if (event && event.target !== leaf) return;
          if (myToken !== turnToken || !animating) return;
          animating = false;
          leaf!.dataset.turning = 'false';
          leaf!.removeEventListener('animationend', land);
          pages.forEach((s, i) => stateOf(s, i === index ? 'active' : 'hidden'));
        }
        leaf.addEventListener('animationend', land, { once: false });
        window.setTimeout(land, turnMs + 200);
      }

      /** 帧窗格点击：直接跳到该帧所在页（长距离跳页不播翻页动画）。 */
      function jumpToFrame(frame: number): void {
        const target = clampSpread(isNarrow() ? frame : Math.floor(frame / 2), pages.length);
        settle();
        index = target;
        paint();
      }

      prev.addEventListener('click', () => go(-1));
      next.addEventListener('click', () => go(1));

      stripItems.forEach((item, i) => {
        item.addEventListener('click', () => jumpToFrame(i));
      });
      if (typeof narrowMq?.addEventListener === 'function') narrowMq.addEventListener('change', relayout);
      else window.addEventListener('resize', relayout);

      document.addEventListener('keydown', (event) => {
        const active = document.activeElement;
        if (active !== root && !root.contains(active)) return;
        switch (event.key) {
          case 'ArrowRight':
            event.preventDefault();
            go(1);
            break;
          case 'ArrowLeft':
            event.preventDefault();
            go(-1);
            break;
          case 'Home':
            event.preventDefault();
            settle();
            index = 0;
            paint();
            break;
          case 'End':
            event.preventDefault();
            settle();
            index = pages.length - 1;
            paint();
            break;
          default:
            break;
        }
      });

      // 触摸左右滑翻页（指针事件，鼠标不接管，避免与点击冲突）
      let gesture: { x: number; y: number; id: number } | null = null;
      stage.addEventListener('pointerdown', (event) => {
        if (event.pointerType === 'mouse') return;
        gesture = { x: event.clientX, y: event.clientY, id: event.pointerId };
      });
      stage.addEventListener('pointerup', (event) => {
        if (!gesture || gesture.id !== event.pointerId) return;
        const dx = event.clientX - gesture.x;
        const dy = event.clientY - gesture.y;
        gesture = null;
        if (Math.abs(dx) < Math.abs(dy)) return;
        const threshold = Math.max(40, window.innerWidth * 0.08);
        if (dx <= -threshold) go(1);
        else if (dx >= threshold) go(-1);
      });
      stage.addEventListener('pointercancel', () => {
        gesture = null;
      });

      paint();
    }
  }
</script>
