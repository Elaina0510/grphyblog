---
/* ============================================================================
 * index.astro —— 首页（home-page 任务 2–8）：翻「跨页」而非扫网格
 *
 * 结构（对照 doc/preview/home.html + DESIGN §5）：
 *   ① 开场跨页  —— 1/3 文字 · 2/3 图版（.spread / .spread-quiet 家具类）
 *   ② 精选区    —— 读 site.json.featured.photos（手动挑图，改 JSON 即生效、不碰代码）
 *   ③ 最新系列  —— getPublishedSeries()（排 draft）按 order/日期取前 N，卡片=封面+标题+日期+张数
 *   ④ 最新随笔  —— getPublishedPosts() 时间倒序取前 N，卡片=标题+日期+摘要/封面
 *
 * 硬约束（勿偏离）：
 *   - 复用 Base.astro（书脊 + 导航 + 页脚 + 入场编排），页面不重写骨架；
 *   - 图片一律 PhotoPlate：显式 width/height（sidecar 真值）+ loading="lazy"（首屏 LCP 例外 eager+high）；
 *   - 图片 URL 只经 contentImageUrl / entryResourceDir（边界③）；宽高只从 sidecar 取，绝不写死；
 *   - 导航/品牌串只从 site.json 取（SiteMark / Base 已处理），页面不硬编码；
 *   - sample/placeholder 字段（intro / indexNote）渲染必带朱砂 ※示例（诚实口径）；
 *   - v1 无分页 / 无标签页 / 无搜索；朱砂仅盖章级 ≤5%；
 *   - 样式值走 var(--token)，页面 <style> 不出现裸色值 / 曲线 / 字面尺寸（仅 fr / var / 关键字）。
 *
 * 灯箱接线（lightbox 模块 任务 9「三处入口一致」）：
 *   开场图 + 精选入口图按 §2 契约各挂 data-lightbox / data-lightbox-gallery="home" / data-lightbox-index，
 *   并在精选区输出同 gid 的 frames JSON 岛；<Lightbox /> 外壳随页面挂载。
 *   帧数据仍然**只出自 sidecar**（resolvePhoto 已经带 entry.width/height/exif/thumb），首页不新增任何手写来源。
 *   开场图与精选首图是同一张（opening 取 featured[0]）→ 按 src 去重共享一帧与同一索引，
 *   因此图版数（3）可比帧数（2）多，但索引集合恒等于 0..帧数-1。
 * ==========================================================================*/
import Base from '../layouts/Base.astro';
import PhotoPlate from '../components/PhotoPlate.astro';
import ExifCard from '../components/ExifCard.astro';
import SiteMark from '../components/SiteMark.astro';
import Lightbox from '../components/Lightbox.astro';
import site from '../data/site.json';
import { getPublishedPosts, getPublishedSeries } from '../utils/collections';
import { contentImageUrl, contentImageMap, entryResourceDir } from '../utils/contentImages';
import { resolveSeriesCount } from '../utils/photoCount';
import { buildFramesIslandJson, createFrameRegistry } from '../utils/lightbox';
import type { Exif, PhotoEntry, PhotoSidecar } from '../types/photoSidecar';

/** 取前 N 的窗口（视觉稿 3–4 条的节奏；数据不足时按实际条数渲染）。 */
const LATEST_SERIES_N = 4;
const LATEST_POSTS_N = 3;

/* ---- 资源解析：内容夹 photos.meta.json 建成「目录 -> 数组」映射；兜底文件走 contentImageMap ---- */
const sidecarModules = import.meta.glob('/src/content/**/photos.meta.json', {
  eager: true,
  import: 'default',
}) as Record<string, PhotoSidecar>;

/** 资源目录（相对 src/content，如 `series/city-lights`）→ 该条目的 sidecar 数组。 */
const sidecarByDir: Record<string, PhotoSidecar> = {};
for (const [key, mod] of Object.entries(sidecarModules)) {
  const dir = key.replace(/^\/src\/content\//, '').replace(/\/photos\.meta\.json$/, '');
  sidecarByDir[dir] = mod;
}

/** 某条目 photos/ 下的图片路径列表（含缩略图；兜底计数内部会排除 .thumb.webp）。 */
function photosUnder(dir: string): string[] {
  const prefix = `${dir}/photos/`;
  return Object.keys(contentImageMap).filter((k) => k.startsWith(prefix));
}

/** 构建期缺 sidecar 的告警出口（注入给纯函数 resolveSeriesCount）。 */
function warnMissingSidecar(message: string): void {
  console.warn(message);
}

/**
 * 由 collection + id + 相对路径解析出可渲染的照片：URL + sidecar 条目（真实宽高 / EXIF）。
 * 找不到 sidecar 条目（缺宽高 = §6 硬约束不可接受）时返回 null，调用方据此跳过该图，绝不写死尺寸。
 */
function resolvePhoto(
  collection: string,
  id: string,
  file: string,
): { dir: string; url: string; thumbUrl: string; entry: PhotoEntry } | null {
  const dir = entryResourceDir(collection, id);
  const entry = (sidecarByDir[dir] ?? []).find((e) => e.file === file);
  if (!entry) return null;
  return {
    dir,
    url: contentImageUrl(dir, file),
    thumbUrl: contentImageUrl(dir, entry.thumb),
    entry,
  };
}

/* ---- 日期口径：统一 UTC 取日期部分，避免按本地时区偏移一天（与 ExifCard 同口径）---- */
function fmtDate(value: Date | string): string {
  const iso =
    value instanceof Date
      ? Number.isNaN(value.getTime())
        ? ''
        : value.toISOString().slice(0, 10)
      : String(value).trim();
  const m = /^(\d{4})[-/.](\d{1,2})[-/.](\d{1,2})/.exec(iso);
  if (!m) return iso;
  const [, y, mo, d] = m;
  return `${y}.${mo.padStart(2, '0')}.${d.padStart(2, '0')}`;
}

/** 从 Markdown 正文抽一行纯文本摘要（去标记 / 折叠空白 / 截断），无正文返回空串。 */
function excerpt(body: string, max = 96): string {
  const text = String(body ?? '')
    .replace(/```[\s\S]*?```/g, ' ')
    .replace(/<!--[\s\S]*?-->/g, ' ')
    .replace(/!?\[([^\]]*)\]\([^)]*\)/g, '$1')
    .replace(/[#>*_`~]/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();
  if (!text) return '';
  return text.length > max ? `${text.slice(0, max)}…` : text;
}

/* ---- 内容查询（排 draft）：系列按 order/日期、随笔按时间倒序 ---- */
const publishedSeries = await getPublishedSeries();
const publishedPosts = await getPublishedPosts();
const [firstSeries] = publishedSeries;

/* ---- 精选区：site.json.featured.photos -> 解析后的可渲染项（缺 sidecar 的自动跳过）---- */
interface Plate {
  url: string;
  /** 缩略图 URL（灯箱「秒开」那一层；与 url 同一张 sidecar 记录的两种产物） */
  thumb: string;
  width: number;
  height: number;
  alt: string;
  title: string;
  exif: Exif;
}
interface FeaturedItem extends Plate {
  href: string;
  dataFrame: string;
}

const featured: FeaturedItem[] = [];
(site.featured?.photos ?? []).forEach(
  (f: { collection: string; id: string; file: string; title?: string; alt?: string }, i) => {
    const photo = resolvePhoto(f.collection, f.id, f.file);
    if (!photo) return; // 挑了不存在的图：不渲染空板，也不伪造宽高
    featured.push({
      url: photo.url,
      thumb: photo.thumbUrl,
      width: photo.entry.width,
      height: photo.entry.height,
      alt: f.alt ?? f.title ?? '精选照片',
      title: f.title ?? '',
      exif: photo.entry.exif,
      href: `/${f.collection}/${f.id}/`,
      dataFrame: String(i),
    });
  },
);

/* ---- 开场跨页 LCP 图：优先精选第一张，退回首个已发布系列封面；都从 sidecar 取真宽高 ---- */
let opening: Plate | null = null;
if (featured[0]) {
  const f = featured[0];
  opening = {
    url: f.url,
    thumb: f.thumb,
    width: f.width,
    height: f.height,
    alt: f.alt,
    title: f.title,
    exif: f.exif,
  };
} else if (firstSeries) {
  const p = resolvePhoto('series', firstSeries.id, firstSeries.data.cover);
  if (p) {
    opening = {
      url: p.url,
      thumb: p.thumbUrl,
      width: p.entry.width,
      height: p.entry.height,
      alt: `${firstSeries.data.title} · 封面`,
      title: firstSeries.data.title,
      exif: p.entry.exif,
    };
  }
}

/* ---- 最新系列卡片数据：张数走共享 photoCount（sidecar 优先、缺 sidecar 兜底告警）---- */
interface SeriesCard {
  href: string;
  title: string;
  dateText: string;
  count: number;
  cover: { url: string; width: number; height: number; alt: string } | null;
}

function orderKey(e: (typeof publishedSeries)[number]): number {
  return Number.isFinite(e.data.order) ? e.data.order : Number.MAX_SAFE_INTEGER;
}

const latestSeries: SeriesCard[] = [...publishedSeries]
  .sort((a, b) => {
    const byOrder = orderKey(a) - orderKey(b);
    return byOrder !== 0 ? byOrder : b.data.date.getTime() - a.data.date.getTime();
  })
  .slice(0, LATEST_SERIES_N)
  .map((entry) => {
    const dir = entryResourceDir('series', entry.id);
    const folderId = dir.split('/').pop() ?? entry.id;
    const count = resolveSeriesCount({
      sidecar: sidecarByDir[dir] ?? null,
      files: photosUnder(dir),
      entryId: folderId,
      onWarn: warnMissingSidecar,
    });
    const photo = resolvePhoto('series', entry.id, entry.data.cover);
    return {
      href: `/series/${folderId}/`,
      title: entry.data.title,
      dateText: fmtDate(entry.data.date),
      count,
      cover: photo
        ? {
            url: photo.thumbUrl,
            width: photo.entry.thumbWidth,
            height: photo.entry.thumbHeight,
            alt: `${entry.data.title} · 封面`,
          }
        : null,
    };
  });

/* ---- 最新随笔卡片：时间倒序取前 N，卡片=标题+日期+摘要/封面 ---- */
interface PostCard {
  href: string;
  title: string;
  dateText: string;
  excerpt: string;
  cover: { url: string; width: number; height: number; alt: string } | null;
}

const latestPosts: PostCard[] = [...publishedPosts]
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, LATEST_POSTS_N)
  .map((entry) => {
    const dir = entryResourceDir('posts', entry.id);
    const folderId = dir.split('/').pop() ?? entry.id;
    const photo = resolvePhoto('posts', entry.id, entry.data.cover);
    return {
      href: `/posts/${folderId}/`,
      title: entry.data.title,
      dateText: fmtDate(entry.data.date),
      excerpt: excerpt(entry.body),
      cover: photo
        ? {
            url: photo.thumbUrl,
            width: photo.entry.thumbWidth,
            height: photo.entry.thumbHeight,
            alt: `${entry.data.title} · 插图`,
          }
        : null,
    };
  });

/* indexNote / intro 是 sample 占位 -> 每行配 ※示例（诚实口径）。 */
const noteLines: string[] = site.indexNote?.lines ?? [];

/* ---- 灯箱契约（§2）：首页图库 gid = `home`，帧 = 开场图 + 精选入口图 ----
 * 同一张展示图（开场图就是精选首图）只占一帧，两处图版共享同一 data-lightbox-index。
 * 顺序：先按精选顺序（= site.json 挑图顺序，其宽高/exif 皆出自 sidecar），再补未占帧的开场图。 */
const HOME_GALLERY = 'home';
const registry = createFrameRegistry();
const featuredIndexes: number[] = featured.map((item) =>
  registry.indexOf({
    src: item.url,
    thumb: item.thumb,
    width: item.width,
    height: item.height,
    alt: item.alt,
    title: item.title,
    exif: item.exif,
  }),
);
const openingIndex: number | null = opening
  ? registry.indexOf({
      src: opening.url,
      thumb: opening.thumb,
      width: opening.width,
      height: opening.height,
      alt: opening.alt,
      title: opening.title,
      exif: opening.exif,
    })
  : null;
/** frames 岛文本：与 series / posts 同形状（'<' 已转义，防 </script> 提前闭合）。 */
const lightboxJson: string = buildFramesIslandJson(registry.frames);
const homeFrameTotal: number = registry.frames.length;
---

<Base current="home">
  <!-- ① 开场跨页：1/3 文字 · 2/3 图版 -->
  <div class="wrap">
    <section class="spread" aria-label="开卷">
      <div class="spread-quiet rise">
        <h1 class="bookname">
          <SiteMark variant="display" />
        </h1>
        <p class="t-body intro">
          {site.intro?.text}
          {site.intro?.sample ? <span class="demo">※示例</span> : null}
        </p>
        <div class="index-note">
          {
            noteLines.map((line) => (
              <span class="mono">
                {line}
                {site.indexNote?.sample ? <span class="demo">※示例</span> : null}
              </span>
            ))
          }
        </div>
      </div>

      {
        opening ? (
          <PhotoPlate
            class="rise"
            src={opening.url}
            width={opening.width}
            height={opening.height}
            alt={opening.alt}
            loading="eager"
            fetchpriority="high"
            data-frame={featured[0] ? featured[0].dataFrame : '0'}
            lightbox
            lightboxGallery={HOME_GALLERY}
            lightboxIndex={openingIndex ?? 0}
          >
            <span class="stamp" aria-hidden="true">
              精选<br />帧
            </span>
            <ExifCard title={opening.title} exif={opening.exif} />
          </PhotoPlate>
        ) : null
      }
    </section>
  </div>

  <!-- ② 精选区：入口图 = 图版 + 页码片，链到对应系列详情；照片本身可点开灯箱（gid=home） -->
  {
    featured.length > 0 ? (
      <div class="wrap">
        <section aria-label="精选" data-gallery={HOME_GALLERY}>
          <div class="chapter-head rise">
            <span class="chapter-no">FEATURED</span>
            <h2 class="t-headline">精选</h2>
            <span class="chapter-sub">{`手动挑图 · ${featured.length} 帧`}</span>
          </div>
          <div class="home-grid home-grid--featured rise">
            {featured.map((item, i) => (
              <a class="home-entry" href={item.href}>
                <PhotoPlate
                  src={item.url}
                  width={item.width}
                  height={item.height}
                  alt={item.alt}
                  fit="cover"
                  aspect="4/3"
                  current={i + 1}
                  total={featured.length}
                  data-frame={item.dataFrame}
                  lightbox
                  lightboxGallery={HOME_GALLERY}
                  lightboxIndex={featuredIndexes[i] ?? i}
                />
                <span class="home-entry__title t-title">{item.title}</span>
                <span class="mono">进册 →</span>
              </a>
            ))}
          </div>

          {
            /* 灯箱帧序列岛（§2）：开场图 + 精选入口图，同 src 只占一帧。 */
            homeFrameTotal > 0 ? (
              <script
                type="application/json"
                class="lightbox-frames"
                data-gallery={HOME_GALLERY}
                set:html={lightboxJson}
              />
            ) : null
          }
        </section>
      </div>
    ) : null
  }

  <!-- ③ 最新系列：封面 + 标题 + 日期 + 张数（张数复用共享 photoCount） -->
  {
    latestSeries.length > 0 ? (
      <div class="wrap">
        <section aria-label="最新系列">
          <div class="chapter-head rise">
            <span class="chapter-no">SERIES</span>
            <h2 class="t-headline">最新系列</h2>
            <span class="chapter-sub">{`已收录 ${latestSeries.length} 册`}</span>
          </div>
          <div class="home-grid rise">
            {latestSeries.map((card) => (
              <a class="home-entry" href={card.href}>
                {card.cover ? (
                  <PhotoPlate
                    src={card.cover.url}
                    width={card.cover.width}
                    height={card.cover.height}
                    alt={card.cover.alt}
                    fit="cover"
                    aspect="4/3"
                    zoom={false}
                  />
                ) : null}
                <span class="home-entry__title t-title">{card.title}</span>
                <span class="mono">{`${card.count} 帧 · ${card.dateText}`}</span>
              </a>
            ))}
          </div>
        </section>
      </div>
    ) : null
  }

  <!-- ④ 最新随笔：标题 + 日期 + 摘要/封面（时间倒序） -->
  {
    latestPosts.length > 0 ? (
      <div class="wrap">
        <section aria-label="最新随笔">
          <div class="chapter-head rise">
            <span class="chapter-no">ESSAYS</span>
            <h2 class="t-headline">最新随笔</h2>
            <span class="chapter-sub">文字为主 · 插图为辅</span>
          </div>
          <div class="home-grid rise">
            {latestPosts.map((card) => (
              <a class="home-entry" href={card.href}>
                {card.cover ? (
                  <PhotoPlate
                    src={card.cover.url}
                    width={card.cover.width}
                    height={card.cover.height}
                    alt={card.cover.alt}
                    fit="cover"
                    aspect="4/3"
                    zoom={false}
                  />
                ) : null}
                <span class="home-entry__title t-title">{card.title}</span>
                <span class="mono">{card.dateText}</span>
                {card.excerpt ? <p class="home-entry__excerpt">{card.excerpt}</p> : null}
              </a>
            ))}
          </div>
        </section>
      </div>
    ) : null
  }

  <!-- ⑤ 夜底灯箱外壳（签名交互）：只在真有可灯箱帧时挂载；脚本会把它搬到 <body> 末尾并接管键盘/手势 -->
  {homeFrameTotal > 0 ? <Lightbox label="首页精选 · 照片灯箱" /> : null}
</Base>

<style>
  /* 首页自己的组装家具：只用 var()/fr/关键字，不写裸色值 / 曲线 / 字面尺寸。
     跨页几何与页码片等全部复用 global.css 的 token 与 .spread / .chapter-head 类。 */
  .intro {
    max-width: var(--measure-intro);
  }

  .home-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--gap-duo);
    align-items: start;
  }

  .home-entry {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .home-entry__title {
    display: block;
    margin-top: var(--gap-stack-sm);
  }

  .home-entry__excerpt {
    color: var(--ink-soft);
    font-size: var(--text-body);
    line-height: var(--leading-body);
    margin-top: var(--gap-stack-xs);
  }

  /* 窄屏：卡片网格归一；开场跨页由 global.css 的 .spread 自动退化单列。 */
  @media (max-width: 900px) {
    .home-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
