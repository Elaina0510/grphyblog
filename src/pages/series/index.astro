---
/* ============================================================================
 * series/index.astro —— 系列列表（series-pages 任务 1）：目次点线行
 *
 * 结构（DESIGN §10 目次 + §5 系列列表 = 封面+标题+日期+张数）：
 *   章节题行（INDEX · 目次 · 已收录 N 册）→ .toc 点线目录行；
 *   每行 = 封面缩略图（走 thumb + thumbWidth/thumbHeight 守预算）+ 册号 No.xx + 题名
 *          + 点线 + 「N 帧 · 日期」元数据。
 *
 * 硬约束（勿偏离）：
 *   - 复用 Base.astro（书脊/导航/页脚/入场编排），current="series"；
 *   - 排 draft + 按 order 再日期排序：一律 getPublishedSeries()（不各自 filter）；
 *   - 张数唯一口径 = resolveSeriesCount（复用 photoCount，sidecar 优先、缺则兜底并告警）；
 *   - 图片 URL 只经 contentImageUrl / entryResourceDir（边界③），宽高只从 sidecar 取；
 *   - 封面用缩略图（thumb + thumbWidth/thumbHeight），不用展示图，控首屏字节；
 *   - v1 无标签页 / 无搜索 / 无编号分页（§5 暂不做）；朱砂仅盖章级 ≤5%（.no 复用 global）；
 *   - 样式值走 var(--token)；页面 <style> 无裸色值 / 字号（本文件的 3.5em 是布局尺寸非字号）。
 * ==========================================================================*/
import Base from '../../layouts/Base.astro';
import PhotoPlate from '../../components/PhotoPlate.astro';
import { getPublishedSeries } from '../../utils/collections';
import { contentImageUrl, contentImageMap, entryResourceDir } from '../../utils/contentImages';
import { resolveSeriesCount } from '../../utils/photoCount';
import type { PhotoSidecar } from '../../types/photoSidecar';

/* ---- sidecar：目录 -> photos.meta.json 数组（与首页同法，import.meta.glob 构建期解析）---- */
const sidecarModules = import.meta.glob('/src/content/**/photos.meta.json', {
  eager: true,
  import: 'default',
}) as Record<string, PhotoSidecar>;

const sidecarByDir: Record<string, PhotoSidecar> = {};
for (const [key, mod] of Object.entries(sidecarModules)) {
  const dir = key.replace(/^\/src\/content\//, '').replace(/\/photos\.meta\.json$/, '');
  sidecarByDir[dir] = mod;
}

/** 某条目 photos/ 下的图片路径列表（含缩略图；兜底计数内部会排除 .thumb.webp）。 */
function photosUnder(dir: string): string[] {
  const prefix = `${dir}/photos/`;
  return Object.keys(contentImageMap).filter((k) => k.startsWith(prefix));
}

function warnMissingSidecar(message: string): void {
  console.warn(message);
}

/**
 * 内容图片 URL：仍只经 contentImageUrl（边界③），但兜住 Vite 内联副作用——
 * <4KB 的缩略图被 `?url` 内联成 `data:...`，imageUrl 又给非 http(s) 串加 '/' 前缀成
 * 不可加载的 `/data:`。这里只剥离这一个误加的前导斜杠。
 */
function serveUrl(entryDir: string, relPath: string): string {
  const url = contentImageUrl(entryDir, relPath);
  return /^\/(?:data|blob):/.test(url) ? url.slice(1) : url;
}

/** 日期口径：UTC 取日期部分，印刷口径 YYYY.MM.DD（与首页 / ExifCard 同）。 */
function fmtDate(value: Date | string): string {
  const iso =
    value instanceof Date
      ? Number.isNaN(value.getTime())
        ? ''
        : value.toISOString().slice(0, 10)
      : String(value).trim();
  const m = /^(\d{4})[-/.](\d{1,2})[-/.](\d{1,2})/.exec(iso);
  if (!m) return iso;
  const [, y, mo, d] = m;
  return `${y}.${mo.padStart(2, '0')}.${d.padStart(2, '0')}`;
}

/* ---- 查询（排 draft）+ 排序：order 升序，再按日期倒序（order 缺省视同最大值）---- */
const published = await getPublishedSeries();
function orderKey(e: (typeof published)[number]): number {
  return Number.isFinite(e.data.order) ? e.data.order : Number.MAX_SAFE_INTEGER;
}
const ordered = [...published].sort((a, b) => {
  const byOrder = orderKey(a) - orderKey(b);
  return byOrder !== 0 ? byOrder : b.data.date.getTime() - a.data.date.getTime();
});

/* ---- 逐行数据：册号 / 题名 / 日期 / 张数 / 封面缩略图 ---- */
interface TocRow {
  href: string;
  no: string;
  title: string;
  dateText: string;
  count: number;
  cover: { url: string; width: number; height: number; alt: string } | null;
}

const rows: TocRow[] = ordered.map((entry, i) => {
  const dir = entryResourceDir('series', entry.id);
  const slug = dir.split('/').pop() ?? entry.id;
  const count = resolveSeriesCount({
    sidecar: sidecarByDir[dir] ?? null,
    files: photosUnder(dir),
    entryId: slug,
    onWarn: warnMissingSidecar,
  });
  const coverEntry = (sidecarByDir[dir] ?? []).find((e) => e.file === entry.data.cover) ?? null;
  return {
    href: `/series/${slug}/`,
    no: `No.${String(i + 1).padStart(2, '0')}`,
    title: entry.data.title,
    dateText: fmtDate(entry.data.date),
    count,
    cover: coverEntry
      ? {
          url: serveUrl(dir, coverEntry.thumb),
          width: coverEntry.thumbWidth,
          height: coverEntry.thumbHeight,
          alt: `${entry.data.title} · 封面`,
        }
      : null,
  };
});
---

<Base
  current="series"
  title="系列 · 目次 —— 柚 · Justyou"
  description="按系列成册的街拍档案：全部册目、册号、帧数与拍摄日期。"
  bodyClass="series-index-page"
>
  <div class="wrap">
    <section class="series-index" aria-label="系列目次">
      <div class="chapter-head rise">
        <span class="chapter-no">INDEX</span>
        <h1 class="t-headline">目次</h1>
        <span class="chapter-sub">{`全部系列 · ${rows.length} 册`}</span>
      </div>

      {
        rows.length > 0 ? (
          <ol class="toc rise">
            {rows.map((row) => (
              <li>
                <a class="toc-row" href={row.href}>
                  {row.cover ? (
                    <span class="toc-cover">
                      <PhotoPlate
                        src={row.cover.url}
                        width={row.cover.width}
                        height={row.cover.height}
                        alt={row.cover.alt}
                        fit="cover"
                        aspect="1/1"
                        zoom={false}
                        shadow={false}
                        loading="lazy"
                      />
                    </span>
                  ) : null}
                  <span class="no">{row.no}</span>
                  <span class="name">{row.title}</span>
                  <span class="dots" aria-hidden="true" />
                  <span class="meta">{`${row.count} 帧 · ${row.dateText}`}</span>
                </a>
              </li>
            ))}
          </ol>
        ) : (
          <p class="t-body series-index__empty">
            本册暂空 —— 用 <code>npm run import</code> 导入照片、在后台写手记后即成册。
          </p>
        )
      }
    </section>
  </div>
</Base>

<style>
  /* 目次行含封面缩略图：把整行从「基线对齐」提为「居中对齐」，让方图与文字同一视觉线。
     用 var()/em/关键字，不写裸色值与字号；--toc-no-w 复用 global 已有度量。 */
  .series-index .toc .toc-row {
    align-items: center;
  }

  .toc-cover {
    flex: 0 0 auto;
    width: 3.5em; /* 布局尺寸（相对字号），非字号 token；约 No. 列宽量级 */
  }

  .series-index__empty {
    color: var(--ink-soft);
  }

  /* 窄屏 375：缩略图收窄、题名不再 nowrap 撑破横向；点线仍可伸展。 */
  @media (max-width: 900px) {
    .toc-cover {
      width: 2.75em;
    }
    .series-index .toc .name {
      white-space: normal;
    }
  }
</style>
